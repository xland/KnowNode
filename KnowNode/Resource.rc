#include "winres.h"

100 ICON "..\\Doc\\logo.ico"

LOGO_SVG         RCDATA "Resources\\logo.svg"
ICON_CENTER      RCDATA "Resources\\center.svg"
ICON_DETAIL_EXPAND  RCDATA "Resources\\detailExpand.svg"
ICON_DETAIL_COLLAPSE RCDATA "Resources\\detailCollapse.svg"
ICON_ADD_LIST    RCDATA "Resources\\addList.svg"
ICON_LIST_BULLET RCDATA "Resources\\ToolbarIcons\\listBullet.svg"
ICON_QUOTE       RCDATA "Resources\\ToolbarIcons\\quote.svg"
ICON_CODE        RCDATA "Resources\\ToolbarIcons\\code.svg"
ICON_IMAGE       RCDATA "Resources\\ToolbarIcons\\image.svg"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
    FILEFLAGS 0x1L
#else
    FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "GitHub xland"
            VALUE "FileDescription", "KnowNode"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "KnowNode.exe"
            VALUE "LegalCopyright", "Copyright (C) LiuXiaolun 2026"
            VALUE "OriginalFilename", "KnowNode.exe"
            VALUE "ProductName", "KnowNode"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
